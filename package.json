{
  "name": "@bevyl-ai/ts-aep",
  "version": "0.5.0",
  "description": "1:1 TypeScript port of py-aep: read and write Adobe After Effects .aep projects (Node, Bun, browsers, Workers)",
  "keywords": [
    "adobe",
    "aep",
    "after-effects",
    "py-aep",
    "rifx"
  ],
  "homepage": "https://github.com/bevyl-ai/ts-aep#readme",
  "bugs": {
    "url": "https://github.com/bevyl-ai/ts-aep/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevyl-ai/ts-aep.git"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/types/py_aep/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/py_aep/index.d.ts",
      "browser": "./dist/browser.js",
      "workerd": "./dist/browser.js",
      "worker": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/types/py_aep/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.src.json",
    "test": "bun test",
    "build": "bun tools/build.ts",
    "prepublishOnly": "bun tools/build.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type exports --fix-type types"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "harfbuzzjs": "0.4.7",
    "yaml": "2.6.0"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "0.15.1",
    "@types/bun": "1.2.21",
    "esbuild": "0.25.10",
    "knip": "6.42.0",
    "lefthook": "2.1.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.3"
  }
}
