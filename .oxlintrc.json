{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": { "correctness": "error" },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "import/no-duplicates": "error",
    // pyrt handles boxed String objects (Python str subclasses) on purpose.
    "typescript/no-wrapper-object-types": "off",
    // The chunk classes merge with their generated field interfaces (binary/chunk_types.ts).
    "typescript/no-unsafe-declaration-merging": "off",
    // Assigning a property its own value runs its setter (tests and bench exercise write paths).
    "no-self-assign": ["error", { "props": false }],
    // `for (const x of [...items]) x.remove()` copies on purpose: the loop changes the collection.
    "unicorn/no-useless-spread": "off",
    // Python's whitespace classes and byte escapes name C0 control characters on purpose.
    "no-control-regex": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }]
  },
  "overrides": [
    {
      // tsc --noUnusedLocals checks src, and also counts TSDoc {@link} references.
      "files": ["src/**"],
      "rules": { "no-unused-vars": "off" }
    }
  ],
  "ignorePatterns": [
    "src/py_aep/binary/chunk_types.ts",
    "src/py_aep/data/text_animator_pool.ts",
    "src/pyrt/codepages.ts",
    "src/pyrt/unicodedata_tables.ts",
    "samples/**",
    ".upstream/**",
    "dist/**"
  ]
}
